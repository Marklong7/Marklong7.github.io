---
const pathname = Astro.url.pathname;
const navItems = [
  { label: "Home", href: "/", active: pathname === "/" },
  { label: "Research", href: "/research/", active: pathname.startsWith("/research") },
  { label: "Talk", href: "/talks/", active: pathname.startsWith("/talks") },
  { label: "Blog", href: "/blog/", active: pathname.startsWith("/blog") },
];
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="wordmark" href="/" aria-label="Jialong (Mark) Li, home">Jialong (Mark) Li</a>

    <nav aria-label="Primary navigation">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={item.active ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border);
    background: var(--color-background);
  }

  .header-inner {
    display: flex;
    min-height: var(--space-8);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .wordmark {
    font-size: var(--text-title);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    text-decoration: none;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  nav a {
    position: relative;
    display: inline-block;
    padding: var(--space-1) 0;
    color: var(--color-muted);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-link);
  }

  nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: calc(-1 * var(--space-1));
    left: 0;
    height: 2px;
    background: var(--color-link);
    content: "";
  }

  @media (max-width: 680px) {
    .header-inner {
      min-height: 0;
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3);
      padding-block: var(--space-4);
    }

    ul {
      gap: var(--space-5);
    }
  }
</style>
