---
const pathname = Astro.url.pathname;
const navItems = [
  { label: "Research", href: "/research/", active: pathname.startsWith("/research") },
  { label: "Blog", href: "/blog/", active: pathname.startsWith("/blog") },
  { label: "Talks", href: "/talks/", active: pathname.startsWith("/talks") },
];
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="wordmark" href="/" aria-label="Jialong Li, home">Jialong Li</a>

    <nav aria-label="Primary navigation">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={item.active ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .header-inner {
    display: flex;
    min-height: 4.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1;
    text-decoration: none;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: clamp(1.1rem, 3vw, 2.5rem);
  }

  nav a {
    position: relative;
    display: inline-block;
    padding: 0.25rem 0;
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-link);
  }

  nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: -0.22rem;
    left: 0;
    height: 2px;
    background: var(--color-accent);
    content: "";
  }

  @media (max-width: 520px) {
    .header-inner {
      min-height: 4.25rem;
      gap: 1rem;
    }

    .wordmark {
      font-size: 1.05rem;
    }

    ul {
      gap: 0.9rem;
    }

    nav a {
      font-size: 0.79rem;
    }
  }
</style>
