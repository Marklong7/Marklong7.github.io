---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { status, period, title, summary, links, authors, collaborators, tags } = project.data;
const selfName = "Jialong (Mark) Li";
---

<article class="entry" data-tone={project.data.tone} data-kind={project.data.kind}>
  <div class="entry-main">
    {
      (status || period) && (
        <p class="entry-meta">
          {status && <span class="status">{status}</span>}
          {period && <span class="period">{period}</span>}
        </p>
      )
    }
    <h3>{title}</h3>
    <p class="summary">{summary}</p>

    {
      links.length > 0 && (
        <ul class="links">
          {links.map((link) => (
            <li>
              <a class="action-link" href={link.url} target="_blank" rel="noreferrer">
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {
    (authors.length > 0 || collaborators.length > 0 || tags.length > 0) && (
      <div class="entry-aside">
        {authors.length > 0 && (
          <p>
            <span class="aside-label">Authors</span>
            {authors.map((author, index) => (
              <>
                {author === selfName ? <strong class="self">{author}</strong> : author}
                {index < authors.length - 1 && ", "}
              </>
            ))}
          </p>
        )}
        {collaborators.length > 0 && (
          <p>
            <span class="aside-label">With</span>
            {collaborators.join(", ")}
          </p>
        )}
        {tags.length > 0 && <p class="tags">{tags.join("\u00a0· ")}</p>}
      </div>
    )
  }
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: var(--space-7);
    padding: var(--space-6) 0;
    border-top: var(--border);
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin: 0 0 var(--space-2);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .status::before {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--color-muted);
    content: "";
  }

  .entry[data-tone="accepted"] .status::before {
    background: var(--color-accent);
  }

  .entry[data-tone="review"] .status::before {
    background: var(--color-status-review);
  }

  .entry[data-kind="project"] .status::before {
    background: var(--color-status-active);
  }

  .period {
    color: var(--color-muted);
  }

  .period::before {
    margin-right: var(--space-3);
    content: "·";
  }

  h3 {
    max-width: var(--width-reading);
    font-size: var(--text-title);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .summary {
    max-width: var(--width-reading);
    margin: var(--space-3) 0 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .entry-aside {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    margin: 0;
    font-size: var(--text-small);
  }

  .entry-aside p {
    margin: 0;
  }

  .aside-label {
    display: block;
    margin-bottom: var(--space-1);
    color: var(--color-muted);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  .self {
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }

  .tags {
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }

    .entry-aside {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  @media (max-width: 520px) {
    .entry-aside {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>
