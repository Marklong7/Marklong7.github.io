---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<article class="project" data-tone={project.data.tone}>
  <p class="number" aria-hidden="true">{number}</p>

  <div class="project-copy">
    {project.data.status && <p class="status">{project.data.status}</p>}
    <h3>{project.data.title}</h3>
    <p class="summary">{project.data.summary}</p>

    {
      project.data.links.length > 0 && (
        <div class="links">
          {project.data.links.map((link) => (
            <a href={link.url} target="_blank" rel="noreferrer">
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )
    }
  </div>

  <dl class="project-meta">
    {
      project.data.collaborators.length > 0 && (
        <div>
          <dt>With</dt>
          <dd>{project.data.collaborators.join(", ")}</dd>
        </div>
      )
    }
    {
      project.data.methods.length > 0 && (
        <div>
          <dt>Methods</dt>
          <dd>{project.data.methods.join(" · ")}</dd>
        </div>
      )
    }
  </dl>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1.2fr) minmax(12rem, 0.55fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: clamp(1.85rem, 4vw, 2.75rem) 0;
    border-top: 1px solid var(--color-border);
  }

  .number {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.7rem;
    color: var(--color-text);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.075em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .status::before {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--color-muted);
    content: "";
  }

  .project[data-tone="accepted"] .status::before {
    background: var(--color-accent);
  }

  .project[data-tone="review"] .status::before {
    background: var(--color-status-review);
  }

  .project[data-tone="ongoing"] .status::before {
    background: var(--color-status-active);
  }

  h3 {
    max-width: 46rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-card-title);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.24;
  }

  .summary {
    max-width: 43rem;
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 1.1rem;
  }

  .links a {
    color: var(--color-text);
    font-size: 0.86rem;
    font-weight: 600;
    text-underline-offset: 0.27em;
  }

  .links a:hover {
    color: var(--color-link);
  }

  .project-meta {
    display: grid;
    align-content: start;
    gap: 1.35rem;
    margin: 0;
    padding-top: 0.15rem;
  }

  .project-meta div {
    display: grid;
    gap: 0.35rem;
  }

  dt {
    color: var(--color-muted);
    font-size: 0.69rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--color-text);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  @media (max-width: 780px) {
    .project {
      grid-template-columns: 1.75rem minmax(0, 1fr);
    }

    .project-meta {
      grid-column: 2;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .project {
      grid-template-columns: 1fr;
    }

    .number,
    .project-meta {
      grid-column: 1;
    }

    .number {
      margin: 0;
    }

    .project-meta {
      grid-template-columns: 1fr;
    }
  }
</style>
