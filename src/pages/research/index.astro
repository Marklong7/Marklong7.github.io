---
import { getCollection } from "astro:content";
import PageHeading from "../../components/PageHeading.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const papers = entries.filter((entry) => entry.data.kind === "paper");
const projects = entries.filter((entry) => entry.data.kind === "project");
---

<BaseLayout
  title="Research · Jialong (Mark) Li"
  description="Papers and ongoing research by Jialong (Mark) Li."
>
  <main id="main-content" class="page shell">
    <PageHeading
      title="Research"
      description="Papers and research projects."
    />

    <section class="research-group" aria-labelledby="papers-title">
      <div class="group-heading">
        <h2 id="papers-title">Papers</h2>
      </div>
      <div class="research-list">
        {papers.map((paper) => <ProjectCard project={paper} />)}
      </div>
    </section>

    <section class="research-group" aria-labelledby="projects-title">
      <div class="group-heading">
        <h2 id="projects-title">Research projects</h2>
      </div>
      <div class="research-list">
        {
          projects.map((project) => <ProjectCard project={project} />)
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .research-group + .research-group {
    margin-top: var(--space-section);
  }

  .group-heading {
    padding-bottom: var(--space-4);
  }

  .group-heading h2 {
    font-size: var(--text-title);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .research-list {
    border-bottom: var(--border);
  }
</style>
