---
import { getCollection } from "astro:content";
import PageHeading from "../../components/PageHeading.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const papers = entries.filter((entry) => entry.data.kind === "paper");
const projects = entries.filter((entry) => entry.data.kind === "project");
---

<BaseLayout
  title="Research · Jialong (Mark) Li"
  description="Papers and ongoing research by Jialong (Mark) Li."
>
  <main id="main-content" class="page shell">
    <PageHeading
      title="Research"
      description="Publications and selected research-assistant work, clearly labeled by stage."
    />

    <section class="research-group" aria-labelledby="papers-title">
      <div class="group-heading">
        <h2 id="papers-title">Papers</h2>
        <p>Accepted and under-review work</p>
      </div>
      <div class="research-list">
        {papers.map((paper) => <ProjectCard project={paper} />)}
      </div>
    </section>

    <section class="research-group" aria-labelledby="projects-title">
      <div class="group-heading">
        <h2 id="projects-title">Research projects</h2>
        <p>Ongoing and earlier RA work · not publications</p>
      </div>
      <div class="research-list">
        {
          projects.map((project) => <ProjectCard project={project} />)
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page {
    min-height: 68vh;
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(5rem, 9vw, 7.5rem);
  }

  .research-group + .research-group {
    margin-top: clamp(4rem, 7vw, 6rem);
  }

  .group-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.1rem;
  }

  .group-heading h2 {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-heading);
    font-weight: 600;
    letter-spacing: -0.012em;
  }

  .group-heading p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-meta);
  }

  .research-list {
    border-bottom: 1px solid var(--color-border);
  }

  @media (max-width: 560px) {
    .group-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
