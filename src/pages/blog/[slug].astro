---
import "katex/dist/katex.min.css";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(post.data.date);
---

<BaseLayout
  title={`${post.data.title} · Jialong (Mark) Li`}
  description={post.data.summary}
  type="article"
>
  <main id="main-content" class="article page shell">
    <header>
      <a class="action-link back" href="/blog/"><span aria-hidden="true">←</span> Blog</a>
      <h1>{post.data.title}</h1>
      <p class="summary">{post.data.summary}</p>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{published}</time>
        {post.data.tags.length > 0 && <span> · {post.data.tags.join(" · ")}</span>}
      </p>
    </header>

    <article class="article-body">
      <Content />
    </article>
  </main>
</BaseLayout>

<style>
  .article {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--width-reading));
  }

  h1 {
    margin-top: var(--space-6);
    font-size: var(--text-display);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .summary {
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
  }

  header .meta {
    margin-top: var(--space-4);
  }

  .article-body {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: var(--border);
  }

  .article-body :global(p),
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 var(--space-5);
  }

  .article-body :global(li + li) {
    margin-top: var(--space-2);
  }

  .article-body :global(h2) {
    margin: var(--space-7) 0 var(--space-3);
    font-size: var(--text-title);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .article-body :global(h3) {
    margin: var(--space-6) 0 var(--space-2);
    font-size: var(--text-body);
    line-height: var(--leading-snug);
  }

  .article-body :global(a) {
    color: var(--color-link);
    text-decoration-thickness: 1px;
    text-underline-offset: var(--underline-offset);
  }

  .article-body :global(figure) {
    margin: var(--space-7) 0;
  }

  .article-body :global(figcaption) {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .article-body :global(blockquote) {
    margin: var(--space-6) 0;
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-border-strong);
    color: var(--color-muted);
  }

  .article-body :global(pre) {
    overflow-x: auto;
    margin: 0 0 var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: var(--border);
    border-radius: var(--radius);
    font-size: var(--text-small);
    line-height: var(--leading-body);
  }

  .article-body :global(code) {
    font-family: var(--font-mono);
  }

  .article-body :global(:not(pre) > code) {
    padding: 0.1em 0.3em;
    border: var(--border);
    border-radius: var(--radius);
    font-size: 0.9em;
  }

  .article-body :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding: var(--space-2) 0;
  }
</style>
