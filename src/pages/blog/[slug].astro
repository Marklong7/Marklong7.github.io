---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(post.data.date);
---

<BaseLayout title={`${post.data.title} · Jialong (Mark) Li`} description={post.data.summary}>
  <main id="main-content" class="article shell">
    <header>
      <a class="back" href="/blog/">← Blog</a>
      <h1>{post.data.title}</h1>
      <p class="summary">{post.data.summary}</p>
      <div class="metadata">
        <time datetime={post.data.date.toISOString()}>{published}</time>
        {post.data.tags.length > 0 && <span>{post.data.tags.join(" · ")}</span>}
      </div>
    </header>

    <article class="article-body">
      <Content />
    </article>
  </main>
</BaseLayout>

<style>
  .article {
    width: min(calc(100% - (2 * var(--page-gutter))), var(--reading-width));
    padding-top: clamp(4.5rem, 9vw, 7.5rem);
    padding-bottom: clamp(6rem, 12vw, 10rem);
  }

  .back {
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 600;
    text-underline-offset: 0.28em;
  }

  header h1 {
    margin: 2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 5.25rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .summary {
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    line-height: 1.6;
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .article-body {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--color-border);
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    margin: 2.4em 0 0.7em;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .article-body :global(h2) {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
  }

  .article-body :global(h3) {
    font-size: 1.4rem;
  }

  .article-body :global(p),
  .article-body :global(li) {
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .article-body :global(a) {
    color: var(--color-accent);
    text-underline-offset: 0.24em;
  }

  .article-body :global(figure) {
    margin: 2.75rem 0;
  }

  .article-body :global(figcaption) {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .article-body :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-accent);
    color: var(--color-muted);
  }

  .article-body :global(pre) {
    overflow-x: auto;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-background);
    font-size: 0.86rem;
  }

  .article-body :global(:not(pre) > code) {
    padding: 0.12em 0.35em;
    border: 1px solid var(--color-border);
    border-radius: 0.3rem;
    font-size: 0.9em;
  }

  .article-body :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.5rem 0;
  }
</style>
