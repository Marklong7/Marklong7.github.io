---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", { year: "numeric", month: "short", day: "numeric" }).format(
    date,
  );
---

<BaseLayout
  title="Blog · Jialong (Mark) Li"
  description="Research notes and essays by Jialong (Mark) Li."
>
  <main id="main-content" class="page shell">
    <header class="page-heading">
      <h1>Blog</h1>
      <p>Notes on experiments, modeling, machine learning, and research practice.</p>
    </header>

    {
      posts.length > 0 ? (
        <ol class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.data.slug}/`}>
                <div>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.summary}</p>
                </div>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-state">The first notes are in progress.</p>
      )
    }
  </main>
</BaseLayout>

<style>
  .page {
    min-height: 68vh;
    padding-top: clamp(5rem, 10vw, 8rem);
    padding-bottom: clamp(6rem, 12vw, 10rem);
  }

  .page-heading {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: end;
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 8vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }

  .page-heading p {
    max-width: 34rem;
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .post-list {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-border);
    list-style: none;
  }

  .post-list li {
    border-top: 1px solid var(--color-border);
  }

  .post-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    padding: 2.5rem 0;
    text-decoration: none;
  }

  .post-list h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.7vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .post-list p {
    max-width: 42rem;
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  time {
    color: var(--color-muted);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .post-list a:hover h2 {
    color: var(--color-accent);
  }

  .empty-state {
    margin: 0;
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  @media (max-width: 680px) {
    .page-heading,
    .post-list a {
      grid-template-columns: 1fr;
    }

    .page-heading {
      gap: 1.25rem;
    }

    .post-list a {
      gap: 1rem;
    }
  }
</style>
