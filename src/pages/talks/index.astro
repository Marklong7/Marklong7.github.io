---
import { getCollection } from "astro:content";
import PageHeading from "../../components/PageHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const talks = (await getCollection("slides", ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);

const formatDate = (date?: Date) =>
  date
    ? new Intl.DateTimeFormat("en", { year: "numeric", month: "short" }).format(date)
    : undefined;
---

<BaseLayout
  title="Talks · Jialong (Mark) Li"
  description="Talks and presentation slides by Jialong (Mark) Li."
>
  <main id="main-content" class="page shell">
    <PageHeading
      title="Talks"
      description="Research presentations and technical reading-group notes."
    />

    <ol class="talk-list">
      {
        talks.map((talk) => {
          const href = talk.data.pdf ?? talk.data.url;
          const date = formatDate(talk.data.date);

          return (
            <li>
              <div class="talk-copy">
                <p class="eyebrow">
                  {[talk.data.event, date].filter(Boolean).join(" · ")}
                </p>
                <h2>{talk.data.title}</h2>
                <p class="description">{talk.data.description}</p>
              </div>
              <a href={href} target="_blank" rel="noreferrer">
                {talk.data.pdf ? "View PDF" : "View notes"} <span aria-hidden="true">↗</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </main>
</BaseLayout>

<style>
  .page {
    min-height: 68vh;
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(5rem, 9vw, 7.5rem);
  }

  .talk-list {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-border);
    list-style: none;
  }

  .talk-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: end;
    padding: clamp(2rem, 4vw, 2.75rem) 0;
    border-top: 1px solid var(--color-border);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.7rem;
    color: var(--color-text);
    font-size: var(--text-meta);
    font-weight: 600;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--color-accent);
    content: "";
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.15;
  }

  .description {
    max-width: 44rem;
    margin: 0.9rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-body);
  }

  .talk-list a {
    color: var(--color-text);
    font-size: var(--text-meta);
    font-weight: 600;
    white-space: nowrap;
    text-underline-offset: 0.28em;
  }

  .talk-list a:hover {
    color: var(--color-link);
  }

  @media (max-width: 680px) {
    .talk-list li {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.25rem;
    }
  }
</style>
