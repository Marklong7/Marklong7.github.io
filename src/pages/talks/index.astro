---
import { getCollection } from "astro:content";
import PageHeading from "../../components/PageHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const talks = (await getCollection("slides", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);

const formatDate = (date?: Date) =>
  date
    ? new Intl.DateTimeFormat("en", { year: "numeric", month: "short" }).format(date)
    : undefined;
---

<BaseLayout
  title="Talk · Jialong (Mark) Li"
  description="Talks and presentation slides by Jialong (Mark) Li."
>
  <main id="main-content" class="page shell">
    <PageHeading
      title="Talk"
      description="Research presentations and technical reading-group notes."
    />

    <ol class="talk-list">
      {
        talks.map((talk) => {
          const href = talk.data.pdf ?? talk.data.url;
          const date = formatDate(talk.data.date);

          return (
            <li class:list={{ "without-cover": !talk.data.cover }}>
              {talk.data.cover && (
                <a class="talk-cover" href={href} target="_blank" rel="noreferrer" aria-label={`View slides: ${talk.data.title}`}>
                  <img src={talk.data.cover} alt={`Cover of ${talk.data.title}`} loading="lazy" decoding="async" />
                </a>
              )}
              <div class="talk-copy">
                <p class="eyebrow">
                  {[talk.data.event, date].filter(Boolean).join(" · ")}
                </p>
                <h2><a href={href} target="_blank" rel="noreferrer">{talk.data.title}</a></h2>
                <p class="description">{talk.data.description}</p>
                <a class="talk-action" href={href} target="_blank" rel="noreferrer">
                  {talk.data.pdf ? "View slides" : "View notes"} <span aria-hidden="true">↗</span>
                </a>
              </div>
            </li>
          );
        })
      }
    </ol>
  </main>
</BaseLayout>

<style>
  .page {
    min-height: 68vh;
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(5rem, 9vw, 7.5rem);
  }

  .talk-list {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-border);
    list-style: none;
  }

  .talk-list li {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(2rem, 4vw, 2.75rem) 0;
    border-top: 1px solid var(--color-border);
  }

  .talk-list li.without-cover {
    grid-template-columns: 1fr;
  }

  .talk-cover {
    display: block;
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .talk-cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .talk-cover:hover {
    border-color: var(--color-accent);
  }

  .talk-copy {
    min-width: 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.7rem;
    color: var(--color-text);
    font-size: var(--text-body);
    font-weight: 600;
    line-height: 1.45;
  }

  .eyebrow::before {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--color-accent);
    content: "";
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 500;
    letter-spacing: -0.028em;
    line-height: 1.15;
  }

  .description {
    max-width: 44rem;
    margin: 0.9rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-body);
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  .talk-action {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-text);
    font-size: var(--text-body);
    font-weight: 600;
    white-space: nowrap;
    text-underline-offset: 0.28em;
  }

  .talk-list a:hover {
    color: var(--color-link);
  }

  .talk-list a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 680px) {
    .talk-list li {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.25rem;
    }
  }
</style>
