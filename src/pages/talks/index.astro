---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import PageHeading from "../../components/PageHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const talks = (await getCollection("slides", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const firstCoverId = talks.find((talk) => talk.data.cover)?.id;
---

<BaseLayout
  title="Talk · Jialong (Mark) Li"
  description="Talks and presentation slides by Jialong (Mark) Li."
>
  <main id="main-content" class="page shell">
    <PageHeading
      title="Talk"
      description="Research presentations and technical reading-group notes."
    />

    <ol class="talk-list">
      {
        talks.map((talk) => {
          const href = talk.data.pdf ?? talk.data.url;
          const label = talk.data.linkLabel ?? (talk.data.pdf ? "View slides" : "View notes");
          const hasDetails =
            talk.data.topics.length > 0 ||
            talk.data.selectedTalks.length > 0 ||
            talk.data.resources.length > 0;
          const isFirstCover = talk.id === firstCoverId;

          return (
            <li class:list={["talk", { "without-cover": !talk.data.cover }]}>
              <div class="talk-copy">
                {talk.data.event && <p class="meta">{talk.data.event}</p>}
                <h2>
                  <a href={href} target="_blank" rel="noreferrer">
                    {talk.data.title}
                  </a>
                </h2>
                <p class="description">{talk.data.description}</p>
                <a class="action-link talk-action" href={href} target="_blank" rel="noreferrer">
                  {label} <span aria-hidden="true">↗</span>
                </a>

                {hasDetails && (
                  <details class="talk-details">
                    <summary class="action-link">Topics and selected talks</summary>
                    {talk.data.topics.length > 0 && (
                      <section class="detail-section" aria-label="Topics">
                        <h3>Topics</h3>
                        <p>{talk.data.topics.join(" · ")}</p>
                      </section>
                    )}
                    {talk.data.selectedTalks.length > 0 && (
                      <section class="detail-section" aria-label="Selected talks">
                        <h3>Selected talks</h3>
                        <ul class="resource-list">
                          {talk.data.selectedTalks.map((link) => (
                            <li>
                              <a class="text-link" href={link.url} target="_blank" rel="noreferrer">
                                {link.label} <span aria-hidden="true">↗</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </section>
                    )}
                    {talk.data.resources.length > 0 && (
                      <section class="detail-section" aria-label="Getting started">
                        <h3>Getting started</h3>
                        <ul class="resource-list">
                          {talk.data.resources.map((link) => (
                            <li>
                              <a class="text-link" href={link.url} target="_blank" rel="noreferrer">
                                {link.label} <span aria-hidden="true">↗</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </section>
                    )}
                  </details>
                )}
              </div>

              {talk.data.cover && (
                <a
                  class="talk-cover"
                  href={href}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`${label}: ${talk.data.title}`}
                >
                  <Image
                    src={talk.data.cover}
                    alt={`Cover of ${talk.data.title}`}
                    widths={[480, 820, 1200]}
                    sizes="(max-width: 860px) min(32rem, calc(100vw - 2.5rem)), 26rem"
                    format="webp"
                    loading={isFirstCover ? "eager" : "lazy"}
                    fetchpriority={isFirstCover ? "high" : undefined}
                  />
                </a>
              )}
            </li>
          );
        })
      }
    </ol>
  </main>
</BaseLayout>

<style>
  .talk-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: var(--border);
  }

  .talk {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 26rem;
    gap: var(--space-7);
    align-items: start;
    padding: var(--space-6) 0;
    border-top: var(--border);
  }

  .talk.without-cover {
    grid-template-columns: minmax(0, 1fr);
  }

  .talk-copy {
    min-width: 0;
  }

  .talk-copy > .meta {
    margin-bottom: var(--space-2);
  }

  h2 {
    font-size: var(--text-title);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-link);
  }

  .description {
    max-width: var(--width-reading);
    margin: var(--space-3) 0 0;
  }

  .talk-action {
    display: inline-block;
    margin-top: var(--space-4);
  }

  .talk-cover {
    display: block;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius);
  }

  .talk-cover:hover {
    border-color: var(--color-border-strong);
  }

  .talk-cover img {
    width: 100%;
  }

  .talk-details {
    margin-top: var(--space-4);
  }

  .talk-details summary {
    width: fit-content;
    cursor: pointer;
  }

  .detail-section {
    margin-top: var(--space-4);
  }

  .detail-section h3 {
    margin-bottom: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-small);
    line-height: var(--leading-snug);
  }

  .detail-section p {
    margin: 0;
  }

  .resource-list {
    margin: 0;
    padding-left: var(--space-5);
  }

  .resource-list li + li {
    margin-top: var(--space-1);
  }

  @media (max-width: 860px) {
    .talk {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .talk-cover {
      max-width: 32rem;
    }
  }
</style>
