---
import { getCollection } from "astro:content";
import PageHeading from "../../components/PageHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const talks = (await getCollection("slides", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);

const formatDate = (date?: Date) =>
  date
    ? new Intl.DateTimeFormat("en", { year: "numeric", month: "short" }).format(date)
    : undefined;
---

<BaseLayout
  title="Talk · Jialong (Mark) Li"
  description="Talks and presentation slides by Jialong (Mark) Li."
>
  <main id="main-content" class="page shell">
    <PageHeading
      title="Talk"
      description="Research presentations and technical reading-group notes."
    />

    <ol class="talk-list">
      {
        talks.map((talk) => {
          const href = talk.data.pdf ?? talk.data.url;
          const date = formatDate(talk.data.date);

          return (
            <li class:list={{ "without-cover": !talk.data.cover }}>
              <div class="talk-copy">
                <div class="talk-meta">
                  {talk.data.event && <p class="event">{talk.data.event}</p>}
                  {date && <time datetime={talk.data.date?.toISOString().slice(0, 10)}>{date}</time>}
                </div>
                <h2><a href={href} target="_blank" rel="noreferrer">{talk.data.title}</a></h2>
                <p class="description">{talk.data.description}</p>
                <a class="talk-action" href={href} target="_blank" rel="noreferrer">
                  {talk.data.pdf ? "View slides" : "View notes"} <span aria-hidden="true">↗</span>
                </a>
              </div>
              {talk.data.cover && (
                <a class="talk-cover" href={href} target="_blank" rel="noreferrer" aria-label={`View slides: ${talk.data.title}`}>
                  <img src={talk.data.cover} alt={`Cover of ${talk.data.title}`} loading="lazy" decoding="async" />
                </a>
              )}
            </li>
          );
        })
      }
    </ol>
  </main>
</BaseLayout>

<style>
  .page {
    min-height: 68vh;
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(5rem, 9vw, 7.5rem);
  }

  .talk-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-border);
  }

  .talk-list li {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
    padding: clamp(2rem, 4vw, 3rem) 0;
    border-top: 1px solid var(--color-border);
  }

  .talk-copy {
    min-width: 0;
  }

  .talk-meta {
    display: grid;
    gap: 0.25rem;
    margin-bottom: 0.85rem;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 400;
    line-height: 1.45;
  }

  .event {
    margin: 0;
  }

  time {
    white-space: nowrap;
  }

  h2 {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-heading);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    text-wrap: pretty;
  }

  h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .description {
    margin: 0.85rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .talk-action {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-link);
    font-size: var(--text-body);
    font-weight: 500;
    text-decoration: none;
    text-underline-offset: 0.25em;
  }

  .talk-action:hover,
  h2 a:hover {
    text-decoration: underline;
  }

  .talk-cover {
    display: block;
    width: 100%;
    margin-top: 0.2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.25rem;
    overflow: hidden;
  }

  .talk-cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .talk-cover:hover {
    border-color: var(--color-text);
  }

  .talk-list a:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 4px;
  }

  @media (max-width: 720px) {
    .talk-list li {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .talk-cover {
      max-width: 32rem;
      margin-top: 0;
    }
  }
</style>
