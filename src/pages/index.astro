---
import { getImage } from "astro:assets";
import educationLogos from "../assets/education-logos.png";
import BaseLayout from "../layouts/BaseLayout.astro";

const site = Astro.site ?? Astro.url;
const logoSprite = await getImage({ src: educationLogos, format: "webp", quality: 90 });

const affiliations = [
  {
    name: "Stanford University",
    detail: "Predoctoral Research Fellow · 2025\u00a0–\u00a0Present",
    viewBox: "64 34 151 150",
  },
  {
    name: "Northwestern University",
    detail: "M.S. Machine Learning & Data Science · 2024",
    viewBox: "64 214 150 149",
  },
  {
    name: "University of Illinois Urbana–Champaign",
    detail: "B.S. Statistics · Computer Science minor · 2023",
    viewBox: "64 394 150 150",
  },
];

const directory = [
  {
    title: "Research",
    href: "/research/",
    blurb: "Papers and ongoing research.",
    action: "View research",
  },
  {
    title: "Talk",
    href: "/talks/",
    blurb: "Research presentations and reading-group slides.",
    action: "View talks",
  },
  {
    title: "Blog",
    href: "/blog/",
    blurb: "Notes on research, methods, and ideas.",
    action: "Read blog",
  },
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jialong (Mark) Li",
  alternateName: ["Jialong Li", "Mark Li"],
  url: new URL("/", site).href,
  image: new URL("/og-image.png", site).href,
  email: "mailto:markli@stanford.edu",
  jobTitle: "Predoctoral Research Fellow",
  worksFor: {
    "@type": "CollegeOrUniversity",
    name: "Stanford Graduate School of Business",
    parentOrganization: { "@type": "CollegeOrUniversity", name: "Stanford University" },
  },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Northwestern University" },
    { "@type": "CollegeOrUniversity", name: "University of Illinois Urbana-Champaign" },
  ],
  knowsAbout: [
    "Quantitative Marketing",
    "Data Privacy",
    "Recommender Systems",
    "Generative AI",
    "Machine Learning",
  ],
  sameAs: [
    "https://github.com/Marklong7",
    "https://www.linkedin.com/in/jialong-mark-li-b3b83a203/",
  ],
};
---

<BaseLayout>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <main id="main-content">
    <section class="hero shell" aria-labelledby="page-title">
      <div class="hero-layout">
        <div class="hero-heading">
          <h1 id="page-title">Jialong (Mark) Li</h1>
          <p class="role">
            <span>Predoctoral Research Fellow</span>
            <span>Stanford Graduate School of Business</span>
          </p>
        </div>

        <div class="hero-copy">
          <p>
            Hi, I’m Jialong (Mark) Li, a predoc at Stanford Graduate School of Business. My work
            focuses on Quantitative Marketing and Operations, Information &amp; Technology.
          </p>
          <p>
            My long-term goal is to help design AI systems that create holistic value for firms,
            users, and society — which requires integrating social impact (data privacy and social
            welfare) with technical performance (accuracy and efficiency) from day one.
          </p>
          <p>
            Currently, my primary research focuses on Gen AI and Data Privacy, particularly within
            recommendation systems and online platforms. Lately, I am also exploring AI for formal
            methods — using mathematical tools to formally verify system behavior before deployment,
            moving away from reactive post-failure debugging.
          </p>
          <ul class="intro-links" aria-label="Contact links">
            <li><a class="action-link" href="mailto:markli@stanford.edu">markli@stanford.edu</a></li>
            <li>
              <a
                class="action-link"
                href="https://www.linkedin.com/in/jialong-mark-li-b3b83a203/"
                target="_blank"
                rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a
              >
            </li>
            <li>
              <a class="action-link" href="https://github.com/Marklong7" target="_blank" rel="noreferrer"
                >GitHub <span aria-hidden="true">↗</span></a
              >
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="education shell" aria-labelledby="education-title">
      <h2 id="education-title">Education</h2>
      <ol class="affiliations">
        {
          affiliations.map((affiliation) => (
            <li>
              <svg
                class="institution-logo"
                viewBox={affiliation.viewBox}
                role="img"
                aria-label={`${affiliation.name} logo`}
              >
                <image href={logoSprite.src} width="264" height="644" />
              </svg>
              <div>
                <h3>{affiliation.name}</h3>
                <p class="meta">{affiliation.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <nav class="directory shell" aria-label="Explore the website">
      {
        directory.map((item) => (
          <a href={item.href}>
            <h2>{item.title}</h2>
            <p>{item.blurb}</p>
            <span class="action">
              {item.action} <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </nav>
  </main>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-section);
    padding-bottom: var(--space-section);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(20rem, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-8);
    align-items: start;
  }

  h1 {
    font-size: var(--text-display);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .role {
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    line-height: var(--leading-snug);
  }

  .role span {
    display: block;
  }

  .role span:first-child {
    margin-bottom: var(--space-1);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .hero-copy {
    max-width: var(--width-reading);
  }

  .hero-copy p {
    margin: 0;
  }

  .hero-copy p + p {
    margin-top: var(--space-4);
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .education {
    padding-bottom: var(--space-section);
  }

  .education > h2,
  .directory h2 {
    font-size: var(--text-title);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .affiliations {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--space-5) 0 0;
    padding: var(--space-5) 0 0;
    border-top: var(--border);
    list-style: none;
  }

  .affiliations li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    padding-right: var(--space-5);
  }

  .affiliations li + li {
    padding-left: var(--space-5);
    border-left: var(--border);
  }

  .institution-logo {
    display: block;
    width: 4rem;
    height: 4rem;
  }

  .affiliations h3 {
    font-size: var(--text-body);
    line-height: var(--leading-snug);
  }

  .affiliations .meta {
    margin-top: var(--space-1);
  }

  .directory {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--border);
  }

  .directory > a {
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--space-5) var(--space-7);
    text-decoration: none;
  }

  .directory > a:first-child {
    padding-left: 0;
  }

  .directory > a + a {
    border-left: var(--border);
  }

  .directory p {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
  }

  .action {
    margin-top: auto;
    padding-top: var(--space-5);
    color: var(--color-link);
    font-weight: var(--weight-semibold);
  }

  .directory > a:hover h2 {
    color: var(--color-link);
  }

  .directory > a:hover .action {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  @media (max-width: 860px) {
    .hero-layout {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 720px) {
    .affiliations {
      grid-template-columns: 1fr;
      padding-top: 0;
    }

    .affiliations li,
    .affiliations li + li {
      padding: var(--space-4) 0;
      border-left: 0;
    }

    .affiliations li + li {
      border-top: var(--border);
    }

    .directory {
      grid-template-columns: 1fr;
    }

    .directory > a,
    .directory > a:first-child {
      padding: var(--space-5) 0;
    }

    .directory > a + a {
      border-top: var(--border);
      border-left: 0;
    }
  }
</style>
