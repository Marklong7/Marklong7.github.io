---
import BaseLayout from "../layouts/BaseLayout.astro";

const affiliations = [
  {
    name: "Stanford University",
    detail: "Predoctoral Research Fellow · 2025–present",
    viewBox: "64 34 151 150",
  },
  {
    name: "Northwestern University",
    detail: "M.S. Machine Learning & Data Science · 2024",
    viewBox: "64 214 150 149",
  },
  {
    name: "University of Illinois Urbana–Champaign",
    detail: "B.S. Statistics · Computer Science minor · 2023",
    viewBox: "64 394 150 150",
  },
];
---

<BaseLayout>
  <main id="main-content">
    <section class="hero shell" aria-labelledby="page-title">
      <div class="hero-layout">
        <div class="hero-heading">
          <h1 id="page-title">Jialong (Mark) Li</h1>
          <p class="role">
            <span>Predoctoral Research Fellow</span>
            <span>Stanford Graduate School of Business</span>
          </p>
        </div>

        <div class="hero-copy">
          <p class="introduction">
            Hi, I’m Jialong (Mark) Li, a predoctoral research fellow at Stanford Graduate School of
            Business. I work at the intersection of quantitative marketing and Operations,
            Information &amp; Technology, studying how algorithms, data, and AI shape consumer
            behavior and digital markets.
          </p>
          <p>
            My work combines field experiments, econometric models, and machine learning. Before
            Stanford, I studied statistics and computer science at UIUC and earned an M.S. in
            Machine Learning and Data Science from Northwestern University.
          </p>
        </div>
      </div>

      <ol class="affiliations" aria-label="Affiliations and education">
        {
          affiliations.map((affiliation) => (
            <li>
              <svg
                class="institution-logo"
                viewBox={affiliation.viewBox}
                role="img"
                aria-label={`${affiliation.name} logo`}
              >
                <image href="/images/education-logos.png" width="264" height="644" />
              </svg>
              <div>
                <h2>{affiliation.name}</h2>
                <p>{affiliation.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="directory shell" aria-label="Explore the website">
      <a href="/research/">
        <h2>Research</h2>
        <p>Papers and clearly labeled research projects in privacy, markets, and machine learning.</p>
        <span class="action">View research <span aria-hidden="true">→</span></span>
      </a>

      <a href="/blog/">
        <h2>Blog</h2>
        <p>Research notes, methods, figures, and longer-form ideas.</p>
        <span class="action">Read notes <span aria-hidden="true">→</span></span>
      </a>

      <a href="/talks/">
        <h2>Talks</h2>
        <p>Presentation slides and technical reading-group materials.</p>
        <span class="action">View talks <span aria-hidden="true">→</span></span>
      </a>
    </section>

    <section class="say-hello shell" aria-labelledby="hello-title">
      <div class="hello-heading">
        <h2 id="hello-title">Say hello</h2>
      </div>
      <div class="hello-copy">
        <p>
          The easiest way to reach me is by email. You can also connect with me on LinkedIn.
        </p>
        <div class="hello-links">
          <a href="mailto:markli@stanford.edu">markli@stanford.edu</a>
          <a
            href="https://www.linkedin.com/in/jialong-mark-li-b3b83a203/"
            target="_blank"
            rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(3.75rem, 6vw, 5.25rem);
    padding-bottom: clamp(3.25rem, 6vw, 4.75rem);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(23rem, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 7vw, 6.5rem);
    align-items: start;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: -0.042em;
    line-height: 0.98;
  }

  .role {
    max-width: 26rem;
    margin: 0.85rem 0 0;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .role span {
    display: block;
  }

  .role span:first-child {
    color: var(--color-text);
    font-weight: 600;
  }

  .role span + span {
    margin-top: 0.15rem;
  }

  .introduction {
    max-width: 38rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.08rem;
    font-weight: 400;
    letter-spacing: -0.008em;
    line-height: 1.65;
  }

  .hero-copy > p + p {
    max-width: 36rem;
    margin: 1.15rem 0 0;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .affiliations {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(3rem, 5vw, 4rem) 0 0;
    padding: 1.6rem 0 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .affiliations li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1.15rem;
    align-items: center;
    padding-right: clamp(1rem, 3vw, 2.5rem);
  }

  .affiliations li + li {
    padding-left: clamp(1rem, 3vw, 2.5rem);
    border-left: 1px solid var(--color-border);
  }

  .institution-logo {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
  }

  .affiliations h2 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .affiliations p {
    margin: 0.28rem 0 0;
    color: var(--color-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .directory {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .directory > a {
    display: flex;
    min-height: 12.75rem;
    flex-direction: column;
    padding: 1.9rem clamp(1.25rem, 3vw, 2.25rem);
    text-decoration: none;
  }

  .directory > a + a {
    border-left: 1px solid var(--color-border);
  }

  .directory h2 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.2;
  }

  .directory p {
    max-width: 17rem;
    margin: 0.85rem 0 0;
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .action {
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--color-text);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .directory > a:hover h2,
  .directory > a:hover .action {
    color: var(--color-link);
  }

  .say-hello {
    display: grid;
    grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-bottom: clamp(4.5rem, 8vw, 6.5rem);
  }

  .hello-heading h2 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.012em;
  }

  .hello-copy p {
    max-width: 34rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .hello-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
  }

  .hello-copy a {
    color: var(--color-link);
    font-size: 0.95rem;
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 720px) {
    .hero-layout {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .affiliations {
      grid-template-columns: 1fr;
      padding-top: 0;
    }

    .affiliations li {
      padding: 1.15rem 0;
    }

    .affiliations li + li {
      padding-left: 0;
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }

    .directory {
      grid-template-columns: 1fr;
    }

    .directory > a {
      min-height: 10.5rem;
      padding-inline: 0;
    }

    .directory > a + a {
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }

    .say-hello {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
