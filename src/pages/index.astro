---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main id="main-content">
    <section class="hero shell" aria-labelledby="page-title">
      <div class="hero-heading">
        <h1 id="page-title">Jialong <span>(Mark)</span> Li</h1>
        <p class="role">Predoctoral Research Fellow · Stanford Graduate School of Business</p>
      </div>

      <div class="hero-details">
        <p class="introduction">
          I study how algorithmic systems, data, and AI shape consumer behavior and digital
          markets. My work combines field experiments, econometric models, and machine learning.
        </p>

        <div class="contact" aria-label="Contact links">
          <a href="mailto:markli@stanford.edu">Email</a>
          <a href="https://github.com/Marklong7" target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>
    </section>

    <section class="directory shell" aria-label="Explore the website">
      <a href="/research/">
        <span class="index" aria-hidden="true">01</span>
        <h2>Research</h2>
        <p>Papers and clearly labeled research projects in privacy, markets, and machine learning.</p>
        <span class="action">View research <span aria-hidden="true">→</span></span>
      </a>

      <a href="/blog/">
        <span class="index" aria-hidden="true">02</span>
        <h2>Blog</h2>
        <p>Research notes, methods, figures, and longer-form ideas.</p>
        <span class="action">Read notes <span aria-hidden="true">→</span></span>
      </a>

      <a href="/talks/">
        <span class="index" aria-hidden="true">03</span>
        <h2>Talks</h2>
        <p>Presentation slides and technical reading-group materials.</p>
        <span class="action">View talks <span aria-hidden="true">→</span></span>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(4.25rem, 7vw, 6.5rem);
    padding-bottom: clamp(4.75rem, 8vw, 7rem);
  }

  .hero-heading {
    max-width: 68rem;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: -0.042em;
    line-height: 0.98;
  }

  h1 span {
    color: var(--color-muted);
  }

  .role {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .hero-details {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(10rem, 0.65fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: end;
    margin-top: clamp(3rem, 5vw, 4.5rem);
  }

  .introduction {
    max-width: 43rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-lead);
    font-weight: 400;
    letter-spacing: -0.012em;
    line-height: 1.55;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding-bottom: 0.35rem;
  }

  .contact a {
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 600;
    text-underline-offset: 0.3em;
  }

  .contact a:hover {
    color: var(--color-link);
  }

  .directory {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: clamp(5rem, 9vw, 7.5rem);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .directory > a {
    display: flex;
    min-height: 14.5rem;
    flex-direction: column;
    padding: 1.7rem clamp(1.25rem, 3vw, 2.25rem) 1.8rem;
    text-decoration: none;
  }

  .directory > a + a {
    border-left: 1px solid var(--color-border);
  }

  .index {
    color: var(--color-muted);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .directory h2 {
    margin: 1.85rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-card-title);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .directory p {
    max-width: 17rem;
    margin: 0.85rem 0 0;
    color: var(--color-muted);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .action {
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--color-text);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .directory > a:hover h2,
  .directory > a:hover .action {
    color: var(--color-link);
  }

  @media (max-width: 720px) {
    .hero-details {
      grid-template-columns: 1fr;
    }

    .hero-details {
      gap: 2rem;
    }

    .directory {
      grid-template-columns: 1fr;
    }

    .directory > a {
      min-height: 11.5rem;
      padding-inline: 0;
    }

    .directory > a + a {
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }
  }
</style>
