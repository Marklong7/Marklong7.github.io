---
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/zilla-slab/500.css";
import "katex/dist/katex.min.css";
import "../styles/tokens.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jialong (Mark) Li",
  description = "Research in quantitative marketing, algorithmic systems, data privacy, and machine learning.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
